# Copy this file to .env and fill in the values. NEVER commit .env.

# RPC endpoint for Sepolia (Alchemy, Infura, or any public Sepolia RPC)
SEPOLIA_RPC_URL=

# Private key of a TEST wallet only (never your main MetaMask account). 0x prefix optional.
DEPLOYER_PRIVATE_KEY=

# Optional: only needed for `npx hardhat verify`
ETHERSCAN_API_KEY=

# Address of the IssuerManager contract (real one, or the mock).
# Required by scripts/deploy.ts
ISSUER_MANAGER_ADDRESS=

# Founding institutions of the real IssuerManager (comma-separated, same order).
# Required by scripts/deployAll.ts
FOUNDER_ADDRESSES=
FOUNDER_NAMES=
